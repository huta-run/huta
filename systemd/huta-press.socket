[Unit]
Description=huta: Telegram button presses relayed by the OpenClaw plugin

[Socket]
ListenStream=/run/huta/press.sock
SocketUser=root
# Only members of huta-press (the chat gateway's user) may connect; the service also checks the
# peer's user against telegram.relay_user. A press still needs the owner's live secret.
SocketGroup=huta-press
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target
