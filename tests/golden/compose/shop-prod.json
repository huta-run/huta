{
  "name": "huta_shop_prod",
  "networks": {
    "a2": {
      "driver_opts": {
        "com.docker.network.bridge.enable_icc": "true",
        "com.docker.network.bridge.name": "dp-86263b0d40a6"
      },
      "name": "huta_shop_prod_a2"
    },
    "b2": {
      "driver_opts": {
        "com.docker.network.bridge.enable_icc": "true",
        "com.docker.network.bridge.name": "dp-80cd11de173c"
      },
      "name": "huta_shop_prod_b2"
    }
  },
  "services": {
    "slot-a-api": {
      "cap_drop": [
        "ALL"
      ],
      "cpus": 1.0,
      "dns": [
        "127.0.0.254"
      ],
      "environment": {
        "API_DB_KEY": "‹secret›",
        "API_MODE": "full",
        "HUTA_COMPONENT": "api",
        "HUTA_PROJECT": "shop",
        "HUTA_SLOT": "a",
        "HUTA_TARGET": "prod",
        "RELEASE_SHA": "0123456789abcdef0123456789abcdef01234567"
      },
      "image": "sha256:cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd",
      "labels": {
        "run.huta.component": "api",
        "run.huta.project": "shop",
        "run.huta.sha": "0123456789abcdef0123456789abcdef01234567",
        "run.huta.slot": "a",
        "run.huta.target": "prod"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "compress": "false",
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "512m",
      "networks": {
        "a2": {
          "aliases": [
            "api"
          ]
        }
      },
      "pids_limit": 128,
      "pull_policy": "never",
      "read_only": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "stop_grace_period": "10s",
      "tmpfs": [
        "/tmp:size=16777216,mode=1777"
      ],
      "user": "29003:29003",
      "volumes": [
        {
          "bind": {
            "create_host_path": false
          },
          "source": "/var/lib/huta/data/shop/prod",
          "target": "/data",
          "type": "bind"
        }
      ]
    },
    "slot-a-web": {
      "cap_drop": [
        "ALL"
      ],
      "cpus": 1.0,
      "dns": [
        "127.0.0.254"
      ],
