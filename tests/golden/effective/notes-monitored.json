          "NODE_USE_ENV_PROXY": "1",
          "NOTES_TITLE": "notes",
          "NOTES_TOKEN": "‹secret›",
          "NO_PROXY": "localhost,127.0.0.1,huta-egress",
          "PRICE": "$$5",
          "RELEASE_SHA": "<sha>",
          "SENTRY_DSN": "‹secret›",
          "SENTRY_ENVIRONMENT": "prod",
          "SENTRY_RELEASE": "<sha>",
          "all_proxy": "",
          "http_proxy": "http://huta-egress:4880",
          "https_proxy": "http://huta-egress:4880",
          "no_proxy": "localhost,127.0.0.1,huta-egress"
        },
        "extra_hosts": [
          "huta-egress:host-gateway"
        ],
        "image": "<image>",
        "labels": {
          "run.huta.project": "notes",
          "run.huta.sha": "<sha>",
          "run.huta.slot": "b",
          "run.huta.target": "prod"
        },
        "logging": {
          "driver": "json-file",
          "options": {
            "compress": "false",
            "max-file": "3",
            "max-size": "10m"
          }
        },
        "mem_limit": "512m",
        "networks": [
          "n2"
        ],
        "pids_limit": 256,
        "ports": [
          "127.0.0.1:19111:8080"
        ],
        "pull_policy": "never",
        "read_only": true,
        "restart": "unless-stopped",
        "security_opt": [
