    {
      "contains": "",
      "headers": {},
      "path": "/nope",
      "request_headers": {},
      "status": 404
    }
  ],
  "uid": 29002,
  "upstreams": {
    "mail-relay": {
      "port": 4881,
      "to": "127.0.0.1:2525"
    }
  }
