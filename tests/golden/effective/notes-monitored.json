            "source": "/var/lib/huta/data/notes/prod",
            "target": "/data",
            "type": "bind"
          }
        ]
      }
    }
  },
  "container_port": 8080,
  "data": {
    "backup": "hourly",
    "bytes": 2147483648,
    "concurrent": true,
    "concurrent_safe": true,
    "mount": "/data",
    "size": "2g"
  },
  "diag": [],
  "drain": 5,
  "egress": [
    "*.example.net:443",
    "api.example.com:443"
  ],
  "env": {
    "NOTES_TITLE": "notes",
    "PRICE": "$5"
  },
  "health": "/healthz",
  "hosts": [
    "notes.example.org",
    "www.notes.example.org"
  ],
  "job_secrets": {
    "rotate": [
      "ROTATE_KEY"
    ]
  },
  "jobs": [
    {
      "cmd": [
        "python",
        "/app/app.py",
        "rotate"
      ],
      "name": "rotate",
      "schedule": "*-*-* 04:20:00",
      "timeout": 300
    }
  ],
  "limits": {
    "cpus": 2,
    "memory": "512m",
    "pids": 256,
    "tmp": "64m"
  },
  "monitor": {
    "egress": [
      "bugs.example.org:443"
    ],
    "env": [
      "MATOMO_SITE_ID",
      "SENTRY_DSN",
      "SENTRY_ENVIRONMENT",
      "SENTRY_RELEASE"
    ],
    "kinds": [
      "analytics",
      "errors"
    ],
    "missing": []
  },
  "secrets": [
    "NOTES_TOKEN"
  ],
  "slots": [
    19110,
    19111
  ],
  "smoke": [
    {
      "contains": "<title>notes</title>",
      "headers": {
        "content-security-policy": "frame-ancestors 'none'"
      },
      "path": "/",
      "request_headers": {},
      "status": 200
