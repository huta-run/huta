# managed-by: huta — project gw, target media.
# Generated from /etc/huta/projects.d/gw.toml. Do not edit by hand.
media.example.org {
	tls /etc/huta/tls/example.pem /etc/huta/tls/example.key
	@notcf not remote_ip 173.245.48.0/20 2400:cb00::/32
	abort @notcf
	encode zstd gzip
	request_body {
		max_size 1073741824
	}
	reverse_proxy 100.64.0.5:8080 {
		import /etc/caddy/huta-secrets/gw--media.caddy
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
	log {
		output file /var/log/caddy/media.example.org.log
	}
}
