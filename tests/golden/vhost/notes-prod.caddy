# managed-by: huta — project notes, target prod.
# Generated from /etc/huta/projects.d/notes.toml. Do not edit by hand.
notes.example.org, www.notes.example.org {
	tls /etc/huta/tls/example.pem /etc/huta/tls/example.key
	@notcf not remote_ip 173.245.48.0/20 2400:cb00::/32
	abort @notcf
	encode zstd gzip
	reverse_proxy 127.0.0.1:19110
	log {
		output file /var/log/caddy/notes.example.org.log
	}
}
